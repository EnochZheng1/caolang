{
  "name": "caolang",
  "version": "0.2.0",
  "description": "草语言 — a programming language made of Chinese internet slang. Compiles to JavaScript; can build 3D games.",
  "homepage": "https://enochzheng1.github.io/caolang/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnochZheng1/caolang.git"
  },
  "bugs": {
    "url": "https://github.com/EnochZheng1/caolang/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "cao": "dist/cli.js",
    "caolang": "dist/cli.js"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "chinese",
    "programming-language",
    "interpreter",
    "meme",
    "caolang",
    "草语言",
    "compiler",
    "javascript",
    "game",
    "raycasting",
    "esolang",
    "梗"
  ],
  "author": "enochzheng",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
