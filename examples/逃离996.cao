// ============================================================
//  《逃离996》 — 一个用草语言写的 3D 第一人称游戏
//
//  下班时间到了，但老板不让走。
//  在办公室迷宫里躲开老板，用辞职信砸他们，找到「下班」出口润出去。
//  撑到 21:00 还没走？996 模式开启，老板全体狂暴。
//
//  操作：W/S 或 ↑/↓ 前后走，A/D 平移，←/→ 转身（点一下画面可以用鼠标转）
//        空格 / 鼠标左键：扔辞职信
//  手机：左边拖动走路转身，右边点一下扔辞职信
//
//  全部画面都是草语言一个像素一个像素算出来的（光线投射 raycasting）。
//  想改难度？改下面的数字再点「整活！」
// ============================================================

搞个 老板速度 = 1.6        // 老板追你的速度
搞个 老板血量 = 2          // 几封辞职信能送走一个老板
搞个 掉发速度 = 30         // 被老板贴脸时每秒掉多少发量
搞个 新老板间隔 = 15       // 每隔几秒来一个新老板
搞个 游戏网址 = "enochzheng1.github.io/caolang/996.html"

搞个 宽 = 320
搞个 高 = 180
搞个 半高 = 90
开画（宽，高，3）
锁鼠标（）
虚拟手柄（「回车："开始"」）    // 手机上显示摇杆和按钮

// ---------------- 地图 ----------------
// 1 工位隔板  2 KPI 白板  3 落地窗  4 下班出口
// P 你  B 老板  C 咖啡  E 出口前的那一格

搞个 地图文本 = [
  "333333333333333333333333",
  "3P...1.......2......C..3",
  "3....1..B....2.........3",
  "3....1....11111111..B..3",
  "3..C.1....1......1.....3",
  "3....1....1..C...1.....3",
  "3.........1......1111..3",
  "311111....1............3",
  "3.........11112.1111...3",
  "3...B..........1..B....3",
  "3..2222........1.......3",
  "3..............1..C....3",
  "311111111..1111111..1113",
  "3.......1.........1....3",
  "3..C....1....B....1....3",
  "3.......1.........1....3",
  "3...11111..2222...1..113",
  "3.....................E4",
  "3....B..1...........1..3",
  "3.......1..C....B...1..3",
  "31111...1...........1..3",
  "3.......2222..11111.1..3",
  "3..C..........1....B...3",
  "333333333333333333333333",
]
搞个 地图宽 = 长度（地图文本[0]）
搞个 地图高 = 长度（地图文本）

// ---------------- 程序生成的纹理（32×32） ----------------

搞个 纹理大小 = 32

// 三元运算：条件成立给「是」，否则给「否」
整活 二选一（条件，是，否）「
  如果（条件）「栓Q 是」
  栓Q 否
」

整活 做纹理（画法）「
  搞个 t = []
  搞个 y = 0
  卷（y < 纹理大小）「
    搞个 x = 0
    卷（x < 纹理大小）「
      推入（t，画法（x，y））
      x += 1
    」
    y += 1
  」
  栓Q t
」

整活 抖（颜色值，幅度）「
  栓Q 混色（颜色值，颜色（255，255，255），随机（） * 幅度）
」

// 1 工位隔板：灰蓝色绒布，顶上一条铝边
搞个 隔板纹理 = 做纹理（整活（x，y）「
  如果（y < 3）「栓Q 抖（颜色（170，172，180），0.1）」
  如果（x == 0 或者 y == 3）「栓Q 颜色（40，45，60）」
  栓Q 抖（颜色（70，82，110），0.08）
」）

// 2 KPI 白板：红线一路往上涨
搞个 白板纹理 = 做纹理（整活（x，y）「
  如果（x < 2 或者 x > 29 或者 y < 2 或者 y > 29）「栓Q 颜色（150，150，160）」
  搞个 线 = 26 - x * 0.75 + 正弦（x * 0.9） * 2
  如果（绝对值（y - 线） < 1.1）「栓Q 颜色（220，30，30）」
  如果（x % 6 == 0 或者 y % 6 == 0）「栓Q 颜色（205，210，215）」
  栓Q 颜色（240，240，235）
」）

// 3 落地窗：夜景，写字楼的灯还亮着（大家都在加班）
搞个 楼高 = 映射（范围（纹理大小），整活（x）「栓Q 10 + 随机整数（0，14）」）
搞个 窗户纹理 = 做纹理（整活（x，y）「
  如果（x < 1 或者 y < 1 或者 x > 30）「栓Q 颜色（30，30，36）」
  如果（y > 31 - 楼高[x]）「
    如果（x % 3 != 0 并且 y % 3 != 0 并且 随机（） < 0.45）「栓Q 颜色（255，214，110）」
    栓Q 颜色（16，18，30）
  」
  栓Q 混色（颜色（10，14，40），颜色（40，30，80），y / 32）
」）

// 4 下班出口：绿色的门，上面亮着 EXIT
搞个 出口纹理 = 做纹理（整活（x，y）「
  如果（y < 6 并且 x > 6 并且 x < 25）「栓Q 颜色（120，255，140）」
  如果（x < 3 或者 x > 28 或者 y < 8）「栓Q 颜色（20，70，35）」
  如果（x > 22 并且 x < 26 并且 y > 17 并且 y < 21）「栓Q 颜色（255，215，0）」
  栓Q 抖（颜色（30，150，70），0.05）
」）

搞个 墙纹理 = [虚无，隔板纹理，白板纹理，窗户纹理，出口纹理]

// 地毯 + 天花板（有的格子带日光灯）
搞个 地毯纹理 = 做纹理（整活（x，y）「
  搞个 格 = （取整（x / 8） + 取整（y / 8）） % 2
  栓Q 抖（二选一（格 == 0，颜色（38，42，58），颜色（44，48，66）），0.06）
」）
搞个 天花板纹理 = 做纹理（整活（x，y）「
  如果（x == 0 或者 y == 0）「栓Q 颜色（60，60，66）」
  栓Q 抖（颜色（92，92，100），0.04）
」）
搞个 日光灯纹理 = 做纹理（整活（x，y）「
  如果（x > 6 并且 x < 25 并且 y > 10 并且 y < 21）「栓Q 颜色（235，240，255）」
  如果（x == 0 或者 y == 0）「栓Q 颜色（60，60，66）」
  栓Q 颜色（110，110，118）
」）

// ---------------- 像素画精灵（16×16） ----------------

整活 做精灵（行们，调色板）「
  搞个 t = []
  盘它（行：行们）「
    盘它（字：行）「
      如果（字 == "."）「推入（t，-1）」啊这「推入（t，调色板[字]）」
    」
  」
  栓Q t
」

搞个 老板图 = 做精灵（[
  "................",
  ".....HHHHHH.....",
  "....HHHHHHHH....",
  "....SSSSSSSS....",
  "....WbWSSbWW....",
  "....SeSSSSeS....",
  "....SSSSSSSS....",
  ".....SmmmmS.....",
  "......SSSS......",
  "...BBBBRRBBBB...",
  "..BBBBBRRBBBBB..",
  "..BB.BBRRBB.BB..",
  "..SS.BBRRBB.SS..",
  ".....BBBBBB.....",
  ".....BB..BB.....",
  "....KKK..KKK....",
]，「H：颜色（40，30，25），S：颜色（240，190，150），W：颜色（255，255，255），b：颜色（20，20，20），
    e：颜色（20，20，20），m：颜色（150，30，30），B：颜色（35，40，70），R：颜色（210，20，30），K：颜色（15，15，15）」）

// 被砸中时的老板（脸都气红了）
搞个 老板受伤图 = 映射（老板图，整活（c）「
  如果（c == -1）「栓Q -1」
  栓Q 混色（c，颜色（255，60，60），0.6）
」）

搞个 咖啡图 = 做精灵（[
  "................",
  "......s..s......",
  ".......s..s.....",
  "......s..s......",
  "................",
  "...WWWWWWWWW....",
  "...WccccccccWWW.",
  "...WccccccccW..W",
  "...WWWWWWWWWW..W",
  "...WWWWWWWWWWWW.",
  "...WWWWWWWWWW...",
  "....WWWWWWWW....",
  ".....WWWWWW.....",
  "..DDDDDDDDDDDD..",
  "................",
  "................",
]，「s：颜色（200，200，210），W：颜色（245，245,245），c：颜色（110，60，30），D：颜色（150，150，160）」）

搞个 辞职信图 = 做精灵（[
  "................",
  "................",
  "................",
  "....WWWWWWWW....",
  "....WkkkkkkW....",
  "....WWWWWWWW....",
  "....WkkkkkWW....",
  "....WWWWWWWW....",
  "....WkkkkkkW....",
  "....WWWWWWWW....",
  "....WkkkWWWW....",
  "....WWWWWWrW....",
  "....WWWWWWWW....",
  "................",
  "................",
  "................",
]，「W：颜色（250，250,245），k：颜色（60，60，70），r：颜色（220，30，30）」）

// 你手里那一沓辞职信
搞个 手图 = 做精灵（[
  "......WWWWWW....",
  ".....WkkkkkW....",
  ".....WWWWWWW....",
  ".....WkkkkWW....",
  "....SWWWWWWWS...",
  "...SSSWWWWWSSS..",
  "..SSSSSSSSSSSSS.",
  "..SSSSSSSSSSSSS.",
  "..SSSSSSSSSSSSS.",
  "...SSSSSSSSSSS..",
  "...CCCCCCCCCCC..",
  "...CCCCCCCCCCC..",
  "...CCCCCCCCCCC..",
  "...CCCCCCCCCCC..",
  "...CCCCCCCCCCC..",
  "...CCCCCCCCCCC..",
]，「W：颜色（250，250,245），k：颜色（60，60，70），S：颜色（235，185，145），C：颜色（50，60，110）」）

// ---------------- 游戏状态 ----------------

搞个 地图 = []
搞个 出生点 = []
搞个 老板们 = []
搞个 咖啡们 = []
搞个 信们 = []
搞个 碎纸们 = []
搞个 弹幕们 = []
搞个 距离场 = []

搞个 玩家x = 0
搞个 玩家y = 0
搞个 朝向x = 1
搞个 朝向y = 0
搞个 镜头x = 0
搞个 镜头y = 0.66

搞个 发量 = 100
搞个 摸鱼值 = 0
搞个 送走数 = 0
搞个 游戏分钟 = 0          // 从 18:00 开始算
搞个 已用秒 = 0
搞个 冷却 = 0
搞个 扔信动画 = 0
搞个 走路相位 = 0
搞个 震动 = 0
搞个 红屏 = 0
搞个 新老板计时 = 0
搞个 距离场计时 = 0
搞个 状态 = "标题"
搞个 狂暴 = 没有内味
搞个 已警告996 = 没有内味

搞个 深度缓冲 = []
盘它（i：范围（宽））「推入（深度缓冲，0）」

搞个 老板台词 = ["这个需求很简单", "今晚加个班吧", "年轻人要多吃苦", "福报懂不懂", "格局打开", "明天上线", "你的工位在等你", "别急着走啊"]

整活 加弹幕（文字，颜色值）「
  推入（弹幕们，「文字，颜色：颜色值，剩余：1.6」）
」

整活 重开（）「
  地图 = []
  出生点 = []
  老板们 = []
  咖啡们 = []
  信们 = []
  碎纸们 = []
  弹幕们 = []
  盘它（y，行：地图文本）「
    搞个 格们 = []
    盘它（x，字：行）「
      如果（字 == "1" 或者 字 == "2" 或者 字 == "3" 或者 字 == "4"）「
        推入（格们，数字化（字））
      」啊这「
        推入（格们，0）
      」
      如果（字 == "P"）「
        玩家x = x + 0.5
        玩家y = y + 0.5
      」
      如果（字 == "B"）「推入（出生点，「x：x + 0.5，y：y + 0.5」）」
      如果（字 == "C"）「推入（咖啡们，「x：x + 0.5，y：y + 0.5，图：咖啡图」）」
    」
    推入（地图，格们）
  」
  朝向x = 1
  朝向y = 0
  镜头x = 0
  镜头y = 0.66
  发量 = 100
  摸鱼值 = 0
  送走数 = 0
  游戏分钟 = 0
  已用秒 = 0
  新老板计时 = 0
  狂暴 = 没有内味
  已警告996 = 没有内味
  // 一开始先来三个离你远的老板
  盘它（点：出生点）「
    如果（长度（老板们） < 3 并且 距离（点.x，点.y，玩家x，玩家y） > 8）「派老板（点）」
  」
  算距离场（）
」

整活 派老板（点）「
  推入（老板们，「x：点.x，y：点.y，血：老板血量，受伤：0，图：老板图，台词冷却：0」）
」

整活 距离（ax，ay，bx，by）「
  栓Q 开方（（ax - bx） * （ax - bx） + （ay - by） * （ay - by））
」

整活 格子（x，y）「
  搞个 mx = 取整（x）
  搞个 my = 取整（y）
  如果（mx < 0 或者 my < 0 或者 mx >= 地图宽 或者 my >= 地图高）「栓Q 1」
  栓Q 地图[my][mx]
」

整活 是墙（x，y）「
  栓Q 格子（x，y） > 0
」

// 从玩家出发 BFS，算出每一格离玩家多远 —— 老板顺着它穿过迷宫追你
整活 算距离场（）「
  距离场 = []
  盘它（y：范围（地图高））「推入（距离场，映射（范围（地图宽），整活（x）「栓Q 9999」））」
  搞个 起x = 取整（玩家x）
  搞个 起y = 取整（玩家y）
  距离场[起y][起x] = 0
  搞个 队列 = [[起x，起y]]
  搞个 头 = 0
  卷（头 < 长度（队列））「
    搞个 当前 = 队列[头]
    头 += 1
    搞个 d = 距离场[当前[1]][当前[0]] + 1
    盘它（方向：[[1，0]，[-1，0]，[0，1]，[0，-1]]）「
      搞个 nx = 当前[0] + 方向[0]
      搞个 ny = 当前[1] + 方向[1]
      如果（地图[ny][nx] == 0 并且 距离场[ny][nx] > d）「
        距离场[ny][nx] = d
        推入（队列，[nx，ny]）
      」
    」
  」
」

// ---------------- 更新 ----------------

整活 试着走（dx，dy）「
  搞个 边距 = 0.2
  搞个 新x = 玩家x + dx
  搞个 新y = 玩家y + dy
  搞个 偏x = 二选一（dx > 0，边距，-边距）
  搞个 偏y = 二选一（dy > 0，边距，-边距）
  如果（非 是墙（新x + 偏x，玩家y））「玩家x = 新x」
  如果（非 是墙（玩家x，新y + 偏y））「玩家y = 新y」
」

整活 转身（角度）「
  搞个 c = 余弦（角度）
  搞个 s = 正弦（角度）
  搞个 旧x = 朝向x
  朝向x = 朝向x * c - 朝向y * s
  朝向y = 旧x * s + 朝向y * c
  搞个 旧镜头x = 镜头x
  镜头x = 镜头x * c - 镜头y * s
  镜头y = 旧镜头x * s + 镜头y * c
」

整活 更新玩家（秒）「
  搞个 速度 = 3 * 秒
  搞个 走了 = 没有内味
  如果（按住了吗（"w"） 或者 按住了吗（"上"））「试着走（朝向x * 速度，朝向y * 速度）；走了 = 确实」
  如果（按住了吗（"s"） 或者 按住了吗（"下"））「试着走（-朝向x * 速度，-朝向y * 速度）；走了 = 确实」
  如果（按住了吗（"a"））「试着走（朝向y * 速度，-朝向x * 速度）；走了 = 确实」
  如果（按住了吗（"d"））「试着走（-朝向y * 速度，朝向x * 速度）；走了 = 确实」
  如果（按住了吗（"左"））「转身（-2.6 * 秒）」
  如果（按住了吗（"右"））「转身（2.6 * 秒）」
  转身（鼠标移动（）.x * 0.003）
  如果（走了）「走路相位 += 秒 * 10」

  冷却 -= 秒
  扔信动画 = 最大（0，扔信动画 - 秒 * 4）
  如果（（刚按了吗（"空格"） 或者 鼠标（）.按下） 并且 冷却 <= 0）「
    推入（信们，「x：玩家x + 朝向x * 0.3，y：玩家y + 朝向y * 0.3，vx：朝向x * 9，vy：朝向y * 9，剩余：1.5，图：辞职信图」）
    冷却 = 0.3
    扔信动画 = 1
    嘀（1200，60，0.05，"三角"）
    嘀（700，90，0.04，"三角"）
  」

  // 喝咖啡回血
  咖啡们 = 过滤（咖啡们，整活（杯）「
    如果（距离（杯.x，杯.y，玩家x，玩家y） < 0.6）「
      发量 = 最小（100，发量 + 30）
      加弹幕（"续命咖啡 +30 发量"，颜色（255，220，140））
      嘀（660，80，0.06，"方"）
      嘀（990，120，0.06，"方"）
      栓Q 没有内味
    」
    栓Q 确实
  」）

  // 摸到出口就润
  如果（地图文本[取整（玩家y）][取整（玩家x）] == "E"）「
    状态 = "赢"
    嘀（523，150，0.08）；嘀（659，150，0.08）；嘀（784，300，0.08）
  」
」

整活 更新老板们（秒）「
  距离场计时 -= 秒
  如果（距离场计时 <= 0）「
    算距离场（）
    距离场计时 = 0.25
  」
  搞个 速度 = 老板速度 * 二选一（狂暴，1.7，1）
  盘它（老板：老板们）「
    老板.受伤 = 最大（0，老板.受伤 - 秒）
    老板.图 = 二选一（老板.受伤 > 0，老板受伤图，老板图）
    老板.台词冷却 -= 秒
    // 往距离场里更近的那一格走
    搞个 bx = 取整（老板.x）
    搞个 by = 取整（老板.y）
    搞个 目标x = 玩家x
    搞个 目标y = 玩家y
    搞个 最近 = 距离场[by][bx]
    盘它（方向：[[1，0]，[-1，0]，[0，1]，[0，-1]]）「
      搞个 nx = bx + 方向[0]
      搞个 ny = by + 方向[1]
      如果（距离场[ny][nx] < 最近）「
        最近 = 距离场[ny][nx]
        目标x = nx + 0.5
        目标y = ny + 0.5
      」
    」
    搞个 d = 距离（老板.x，老板.y，玩家x，玩家y）
    如果（d < 1.5）「
      目标x = 玩家x
      目标y = 玩家y
    」
    搞个 到目标 = 距离（老板.x，老板.y，目标x，目标y）
    如果（到目标 > 0.05 并且 d > 0.5）「
      搞个 新x = 老板.x + （目标x - 老板.x） / 到目标 * 速度 * 秒
      搞个 新y = 老板.y + （目标y - 老板.y） / 到目标 * 速度 * 秒
      如果（非 是墙（新x，老板.y））「老板.x = 新x」
      如果（非 是墙（老板.x，新y））「老板.y = 新y」
    」
    // 贴脸就掉头发
    如果（d < 0.75）「
      发量 -= 掉发速度 * 秒
      震动 = 最大（震动，0.25）
      红屏 = 最大（红屏，0.5）
      如果（老板.台词冷却 <= 0）「
        加弹幕（"老板：" + 随便挑（老板台词），颜色（255，120，120））
        老板.台词冷却 = 2.5
        沙沙（120，0.15）
      」
    」
  」

  // 隔一阵来个新老板（远一点的地方）
  新老板计时 += 秒
  如果（新老板计时 > 新老板间隔）「
    新老板计时 = 0
    搞个 远的 = 过滤（出生点，整活（点）「栓Q 距离（点.x，点.y，玩家x，玩家y） > 7」）
    如果（长度（远的） > 0）「
      派老板（随便挑（远的））
      加弹幕（"又来了一个老板……"，颜色（255，170，80））
    」
  」
」

整活 更新信们（秒）「
  搞个 还在飞 = []
  盘它（信：信们）「
    信.x += 信.vx * 秒
    信.y += 信.vy * 秒
    信.剩余 -= 秒
    搞个 砸中 = 没有内味
    盘它（老板：老板们）「
      如果（非 砸中 并且 距离（信.x，信.y，老板.x，老板.y） < 0.45）「
        砸中 = 确实
        老板.血 -= 1
        老板.受伤 = 0.2
        沙沙（80，0.2）
        如果（老板.血 <= 0）「
          摸鱼值 += 100
          送走数 += 1
          加弹幕（"老板：栓Q……（摸鱼值 +100）"，颜色（140，255，160））
          嘀（440，100，0.07，"锯齿"）；嘀（220，200，0.07，"锯齿"）
          盘它（i：范围（24））「
            推入（碎纸们，「x：老板.x，y：老板.y，z：0.5，vx：随机（） * 2 - 1，vy：随机（） * 2 - 1，vz：随机（） * 2，剩余：1.2」）
          」
        」
      」
    」
    如果（非 砸中 并且 非 是墙（信.x，信.y） 并且 信.剩余 > 0）「推入（还在飞，信）」
  」
  信们 = 还在飞
  老板们 = 过滤（老板们，整活（老板）「栓Q 老板.血 > 0」）

  // 漫天飞舞的碎纸
  盘它（纸：碎纸们）「
    纸.x += 纸.vx * 秒
    纸.y += 纸.vy * 秒
    纸.z += 纸.vz * 秒
    纸.vz -= 6 * 秒
    如果（纸.z < 0）「纸.z = 0；纸.vz = 0；纸.vx *= 0.5；纸.vy *= 0.5」
    纸.剩余 -= 秒
  」
  碎纸们 = 过滤（碎纸们，整活（纸）「栓Q 纸.剩余 > 0」）
」

// ---------------- 渲染：光线投射 ----------------

整活 雾色（）「
  栓Q 二选一（狂暴，颜色（45，4，8），颜色（6，6，16））
」

整活 画地板和天花板（雾，闪）「
  搞个 左光x = 朝向x - 镜头x
  搞个 左光y = 朝向y - 镜头y
  搞个 右光x = 朝向x + 镜头x
  搞个 右光y = 朝向y + 镜头y
  搞个 y = 半高 + 1
  卷（y < 高）「
    搞个 行距离 = 半高 / （y - 半高）
    搞个 步x = 行距离 * （右光x - 左光x） / 宽
    搞个 步y = 行距离 * （右光y - 左光y） / 宽
    搞个 地x = 玩家x + 行距离 * 左光x
    搞个 地y = 玩家y + 行距离 * 左光y
    搞个 雾浓度 = 行距离 / 9
    搞个 天花板y = 高 - y - 1
    搞个 x = 0
    卷（x < 宽）「
      搞个 格x = 取整（地x）
      搞个 格y = 取整（地y）
      搞个 tx = 取整（（地x - 格x） * 纹理大小）
      搞个 ty = 取整（（地y - 格y） * 纹理大小）
      搞个 下标 = ty * 纹理大小 + tx
      像素（x，y，混色（地毯纹理[下标]，雾，雾浓度））
      搞个 顶 = 天花板纹理
      如果（（格x + 格y * 3） % 4 == 0）「顶 = 日光灯纹理」
      像素（x，天花板y，混色（混色（顶[下标]，颜色（0，0，0），闪），雾，雾浓度））
      地x += 步x
      地y += 步y
      x += 1
    」
    y += 1
  」
」

整活 画墙（雾）「
  搞个 x = 0
  卷（x < 宽）「
    搞个 镜头偏 = 2 * x / 宽 - 1
    搞个 光x = 朝向x + 镜头x * 镜头偏
    搞个 光y = 朝向y + 镜头y * 镜头偏
    搞个 格x = 取整（玩家x）
    搞个 格y = 取整（玩家y）
    搞个 跨x = 1000000
    搞个 跨y = 1000000
    如果（光x != 0）「跨x = 绝对值（1 / 光x）」
    如果（光y != 0）「跨y = 绝对值（1 / 光y）」
    搞个 步x = 1
    搞个 步y = 1
    搞个 边x = （格x + 1 - 玩家x） * 跨x
    搞个 边y = （格y + 1 - 玩家y） * 跨y
    如果（光x < 0）「步x = -1；边x = （玩家x - 格x） * 跨x」
    如果（光y < 0）「步y = -1；边y = （玩家y - 格y） * 跨y」

    // DDA：一格一格往前走，直到撞墙
    搞个 墙 = 0
    搞个 侧面 = 0
    卷（墙 == 0）「
      如果（边x < 边y）「
        边x += 跨x
        格x += 步x
        侧面 = 0
      」啊这「
        边y += 跨y
        格y += 步y
        侧面 = 1
      」
      墙 = 地图[格y][格x]
    」

    搞个 墙距 = 二选一（侧面 == 0，边x - 跨x，边y - 跨y）
    深度缓冲[x] = 墙距
    搞个 墙高 = 取整（高 / 墙距）
    搞个 起 = 最大（0，取整（半高 - 墙高 / 2））
    搞个 止 = 最小（高 - 1，取整（半高 + 墙高 / 2））

    搞个 墙上x = 二选一（侧面 == 0，玩家y + 墙距 * 光y，玩家x + 墙距 * 光x）
    墙上x -= 取整（墙上x）
    搞个 tx = 取整（墙上x * 纹理大小）
    如果（（侧面 == 0 并且 光x > 0） 或者 （侧面 == 1 并且 光y < 0））「tx = 纹理大小 - 1 - tx」

    搞个 纹理 = 墙纹理[墙]
    搞个 步长 = 纹理大小 / 墙高
    搞个 纹理位置 = 最大（0，（起 - 半高 + 墙高 / 2） * 步长）
    搞个 雾浓度 = 墙距 / 9
    搞个 暗 = 二选一（侧面 == 1，0.35，0）
    // 出口自己会发光，不吃雾
    如果（墙 == 4）「雾浓度 = 雾浓度 * 0.3」
    搞个 y = 起
    卷（y <= 止）「
      搞个 ty = 取整（纹理位置） % 纹理大小
      纹理位置 += 步长
      搞个 c = 纹理[ty * 纹理大小 + tx]
      像素（x，y，混色（混色（c，颜色（0，0，0），暗），雾，雾浓度））
      y += 1
    」
    x += 1
  」
」

// 精灵：投影到屏幕上，逐列和深度缓冲比较，被墙挡住的部分不画
整活 画精灵（物体，图，大小，抬高，雾）「
  搞个 相对x = 物体.x - 玩家x
  搞个 相对y = 物体.y - 玩家y
  搞个 逆 = 1 / （镜头x * 朝向y - 朝向x * 镜头y）
  搞个 变换x = 逆 * （朝向y * 相对x - 朝向x * 相对y）
  搞个 深 = 逆 * （-镜头y * 相对x + 镜头x * 相对y）
  如果（深 <= 0.1）「栓Q 虚无」
  搞个 屏x = 取整（宽 / 2 * （1 + 变换x / 深））
  搞个 尺寸 = 绝对值（取整（高 / 深 * 大小））
  如果（尺寸 < 1）「栓Q 虚无」
  搞个 底 = 取整（半高 + 高 / 深 * （0.5 - 抬高））
  搞个 顶 = 底 - 尺寸
  搞个 左 = 屏x - 取整（尺寸 / 2）
  搞个 雾浓度 = 深 / 9
  搞个 列 = 最大（0，左）
  搞个 右 = 最小（宽 - 1，左 + 尺寸 - 1）
  卷（列 <= 右）「
    如果（深 < 深度缓冲[列]）「
      搞个 tx = 取整（（列 - 左） * 16 / 尺寸）
      搞个 行 = 最大（0，顶）
      搞个 下 = 最小（高 - 1，底 - 1）
      卷（行 <= 下）「
        搞个 ty = 取整（（行 - 顶） * 16 / 尺寸）
        搞个 c = 图[ty * 16 + tx]
        如果（c != -1）「像素（列，行，混色（c，雾，雾浓度））」
        行 += 1
      」
    」
    列 += 1
  」
  栓Q [屏x，顶]
」

整活 画所有精灵（雾）「
